+
+/* AetherDesk rootful monitor layout. No modesetting or system display access:
+ * all CRTCs view rectangles of this Xwayland server's existing root pixmap. */
+static Atom
+desktop_layout_atom(void)
+{
+    const char *name = "_AETHERDESK_OUTPUT_RECTS";
+    return MakeAtom(name, strlen(name), TRUE);
+}
+
+static Bool
+desktop_set_layout(ScreenPtr screen, RROutputPtr output,
+                   Atom property, RRPropertyValuePtr value)
+{
+    struct xwl_screen *xwl_screen = xwl_screen_get(screen);
+    struct xwl_output *fixed = xwl_screen->fixed_output;
+    CARD32 *rects = value->data;
+    unsigned count, i;
+    RRModePtr mode;
+    char name[40];
+
+    if (property != desktop_layout_atom())
+        return TRUE;
+    if (!fixed || output != fixed->randr_output || value->type != XA_CARDINAL ||
+        value->format != 32 || value->size < 4 || value->size > 64 || value->size % 4)
+        return FALSE;
+    count = value->size / 4;
+    for (i = 0; i < count; ++i) {
+        CARD32 *r = rects + 4 * i;
+        if (!r[2] || !r[3] || r[0] >= (unsigned)screen->width || r[1] >= (unsigned)screen->height ||
+            r[2] > (unsigned)screen->width - r[0] || r[3] > (unsigned)screen->height - r[1])
+            return FALSE;
+    }
+    for (i = 0; i < count; ++i) {
+        CARD32 *r = rects + 4 * i;
+        if (!fixed->desktop_outputs[i]) {
+            snprintf(name, sizeof(name), "AetherDesk-%u", i + 1);
+            fixed->desktop_outputs[i] = RROutputCreate(screen, name, strlen(name), NULL);
+            fixed->desktop_crtcs[i] = RRCrtcCreate(screen, fixed);
+            if (!fixed->desktop_outputs[i] || !fixed->desktop_crtcs[i])
+                return FALSE;
+            RRCrtcSetRotations(fixed->desktop_crtcs[i], RR_Rotate_0);
+            RRCrtcGammaSetSize(fixed->desktop_crtcs[i], 256);
+            RROutputSetCrtcs(fixed->desktop_outputs[i], &fixed->desktop_crtcs[i], 1);
+        }
+        mode = xwayland_cvt(r[2], r[3], 60, 0, 0);
+        if (!mode)
+            return FALSE;
+        RROutputSetModes(fixed->desktop_outputs[i], &mode, 1, 1);
+        /* SetModes owns the reference returned by xwayland_cvt. */
+        RRCrtcNotify(fixed->desktop_crtcs[i], mode, r[0], r[1], RR_Rotate_0,
+                     NULL, 1, &fixed->desktop_outputs[i]);
+        RROutputSetPhysicalSize(fixed->desktop_outputs[i], r[2] * 254 / 960, r[3] * 254 / 960);
+        RROutputSetConnection(fixed->desktop_outputs[i], RR_Connected);
+    }
+    for (i = count; i < fixed->desktop_count; ++i) {
+        RRCrtcNotify(fixed->desktop_crtcs[i], NULL, 0, 0, RR_Rotate_0, NULL, 0, NULL);
+        RROutputSetConnection(fixed->desktop_outputs[i], RR_Disconnected);
+    }
+    fixed->desktop_count = count;
+    RRCrtcNotify(fixed->randr_crtc, NULL, 0, 0, RR_Rotate_0, NULL, 0, NULL);
+    RROutputSetConnection(fixed->randr_output, RR_Disconnected);
+    rrGetScrPriv(screen)->primaryOutput = fixed->desktop_outputs[0];
+    RRTellChanged(screen);
+    return TRUE;
+}
