# glibc 2.28 baseline: compatible with Rocky/Alma/RHEL 8 and newer hosts.
FROM almalinux:8 AS builder
LABEL io.aetherdesk.rust-build-cache="true"

RUN dnf install -y dnf-plugins-core epel-release \
    && dnf config-manager --set-enabled powertools \
    && dnf install -y https://download1.rpmfusion.org/free/el/rpmfusion-free-release-8.noarch.rpm \
    && dnf install -y --setopt=install_weak_deps=False \
      ca-certificates curl patch gcc gcc-c++ make git pkgconf-pkg-config python3 xfwm4 dbus-x11 dejavu-sans-fonts openssh-server \
      wayland-devel libxkbcommon-devel systemd-devel libinput-devel \
      mesa-libgbm-devel libdrm-devel mesa-libEGL-devel mesa-libGLES-devel pixman-devel \
      gstreamer1-devel gstreamer1-plugins-base-devel gstreamer1-plugins-base \
      gstreamer1-plugins-good gstreamer1-plugins-bad-free gstreamer1-plugins-ugly gstreamer1-libav \
      python39 python39-pip ninja-build xz libX11-devel libXfont2-devel libxkbfile-devel \
      libXau-devel libXdmcp-devel xorg-x11-proto-devel xorg-x11-xtrans-devel \
      openssl-devel libtirpc-devel libxshmfence-devel xorg-x11-xkb-utils xkeyboard-config zlib-devel \
    && dnf clean all \
    && for element in appsrc appsink videoconvert h264parse x264enc avdec_h264; do \
         gst-inspect-1.0 "$element" >/dev/null || { \
           echo "Missing required Linux video element: $element. Check the GStreamer/RPM Fusion runtime packages." >&2; \
           exit 1; \
         }; \
       done

# XWayland 23.1+ supplies the surface association protocol used by Smithay.
# Build against glibc 2.28 rather than bundling the incompatible RHEL 8 server.
RUN python3.9 -m venv /opt/aetherdesk-build-tools \
    && /opt/aetherdesk-build-tools/bin/pip install --no-cache-dir meson==1.3.2
ENV PATH=/opt/aetherdesk-build-tools/bin:$PATH
COPY tools/build-xwayland.sh tools/xwayland-monitors.patch /tmp/
COPY tools/rust-build-kit/test_xwayland_download.py /tmp/test_xwayland_download.py
RUN AETHERDESK_XWAYLAND_SCRIPT=/tmp/build-xwayland.sh python3.9 /tmp/test_xwayland_download.py \
    && bash /tmp/build-xwayland.sh /opt/aetherdesk-xwayland
ENV PATH=/opt/aetherdesk-xwayland/bin:$PATH
ENV LD_LIBRARY_PATH=/opt/aetherdesk-xwayland/lib

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH=/root/.cargo/bin:$PATH

WORKDIR /src
COPY core/rust /src/core/rust
COPY tools/x11-icons.py /src/tools/x11-icons.py
# Keep compilation in its own cached layer. UI-only regression/catalog/tooling
# changes below must still rerun every test, but need not rebuild the Rust graph.
RUN cargo build --locked --release --manifest-path core/rust/Cargo.toml \
      -p agent-supervisor \
    && cargo test --locked --release --no-run --manifest-path core/rust/Cargo.toml \
      -p agent-wayland -p agent-supervisor -p agent-input -p agent-encoder -p ad-ssh -p ad-stream-protocol -p ad-display-decoder

COPY tools/package-linux-agent.sh /src/tools/package-linux-agent.sh
COPY tools/test_x11_icons.py /src/tools/test_x11_icons.py
COPY rust-regressions.json /src/rust-regressions.json
COPY tools/rust-build-kit/check_regression_registry.py /src/tools/rust-build-kit/check_regression_registry.py
COPY tools/rust-build-kit/test_regression_registry.py /src/tools/rust-build-kit/test_regression_registry.py
COPY tools/rust-build-kit/test_scoped_command.py /src/tools/rust-build-kit/test_scoped_command.py
COPY tools/rust-build-kit/test_terminal_integration.py /src/tools/rust-build-kit/test_terminal_integration.py
COPY tools/rust-build-kit/monitor_host.sh /src/tools/rust-build-kit/monitor_host.sh
COPY tools/rust-build-kit/test_monitoring_collector.py /src/tools/rust-build-kit/test_monitoring_collector.py
COPY ui/rust/crates/ad-desktop/src/connection.rs /src/ui/rust/crates/ad-desktop/src/connection.rs
RUN install -d -m 1777 /tmp/.X11-unix \
    && cargo test --locked --release --manifest-path core/rust/Cargo.toml \
      -p agent-wayland -p agent-supervisor -p agent-input -p agent-encoder -p ad-ssh -p ad-stream-protocol -p ad-display-decoder -- --list > /tmp/native-tests.list \
    && python3 tools/rust-build-kit/check_regression_registry.py --catalog rust-regressions.json --phase linux --list /tmp/native-tests.list \
    && cargo test --locked --release --manifest-path core/rust/Cargo.toml \
      -p agent-wayland -p agent-supervisor -p agent-input -p agent-encoder -p ad-ssh -p ad-stream-protocol -p ad-display-decoder -- --test-threads=1 \
    && python3 tools/rust-build-kit/test_scoped_command.py \
    && python3 tools/rust-build-kit/test_terminal_integration.py \
    && python3 tools/rust-build-kit/test_monitoring_collector.py \
    && python3 tools/test_x11_icons.py \
    && python3 tools/rust-build-kit/test_regression_registry.py \
    && bash tools/package-linux-agent.sh core/rust/target/release/ad-agent /src/agent-bundle \
    && python3 tools/rust-build-kit/check_regression_registry.py --catalog rust-regressions.json --phase linux --list /tmp/native-tests.list --passed --output /src/agent-bundle/regression-results.json

FROM scratch AS artifact
LABEL io.aetherdesk.rust-build-cache="true"
COPY --from=builder /src/agent-bundle/ /
